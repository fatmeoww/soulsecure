# Force LF regardless of the checking-out OS -- these files run as shell
# scripts / systemd units inside Linux containers or on the Linux VM itself.
# A CRLF shebang line ("#!/bin/sh\r") fails to execute at all.
*.sh text eol=lf
labctl text eol=lf
detect-ip.sh text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
*.tmpl text eol=lf
*.conf text eol=lf
docker-compose.yml text eol=lf
